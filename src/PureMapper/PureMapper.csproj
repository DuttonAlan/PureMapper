<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>PureMapper</PackageId>
    <Version>1.0.0</Version>
    <Authors>Alan Dutton</Authors>
    <Copyright>Copyright (c) 2026 Alan Dutton</Copyright>
    <Description>A small, convention-based object-to-object mapper for .NET: flattening, nested objects, collections, records, profiles and dependency injection, with startup validation.</Description>
    <PackageTags>mapper;object-mapper;mapping;dto;convention;flattening</PackageTags>
    <PackageProjectUrl>https://github.com/DuttonAlan/PureMapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DuttonAlan/PureMapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/DuttonAlan/PureMapper/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>

</Project>
